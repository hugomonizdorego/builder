#!/usr/bin/python3 -I
"""Privileged helper of Ubuntu Builder, started by the GUI through pkexec.

Installed as /usr/libexec/ubuntu-builder/ubuntu-builder-helper and named by
the polkit action org.ubuntu-builder.helper. Python runs in isolated mode,
so nothing from the calling user's environment (PYTHONPATH, user site
packages, current directory) can inject code into this root process.
"""

import sys

sys.path.insert(0, "/usr/share/ubuntu-builder")

from ubuntu_builder.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())

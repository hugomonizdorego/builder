<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Ubuntu Builder</vendor>
  <vendor_url>https://launchpad.net/ubuntu-builder</vendor_url>
  <icon_name>ubuntu-builder</icon_name>
  <action id="org.ubuntu-builder.helper">
    <description>Build a custom Ubuntu image</description>
    <message>Authentication is required to extract, modify and build Ubuntu images</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/ubuntu-builder/ubuntu-builder-helper</annotate>
  </action>
</policyconfig>
